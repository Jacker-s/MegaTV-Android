<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Native Media3 PlayerView -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Buffering Progress -->
    <ProgressBar
        android:id="@+id/playerBufferProgress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary_default"
        android:visibility="gone" />

    <!-- Gesture / D-Pad Seek Indicator -->
    <LinearLayout
        android:id="@+id/gestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGestureText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume: 80%"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom Controls Overlay (Works cleanly for both Touch & TV D-Pad) -->
    <FrameLayout
        android:id="@+id/overlayControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/player_overlay_bg">

        <!-- Top Bar: Back & Title -->
        <LinearLayout
            android:id="@+id/playerTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/gradient_scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/btnPlayerBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_player_focus_ring"
                android:clickable="true"
                android:contentDescription="@string/btn_back"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Transport Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnRewind10"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_focus_ring"
                android:clickable="true"
                android:contentDescription="Retroceder 10s"
                android:focusable="true"
                android:padding="13dp"
                android:src="@drawable/ic_back" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="36dp"
                android:background="@drawable/bg_player_focus_ring"
                android:clickable="true"
                android:contentDescription="Play/Pause"
                android:focusable="true"
                android:padding="20dp"
                android:src="@drawable/ic_pause" />

            <ImageView
                android:id="@+id/btnForward10"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_focus_ring"
                android:clickable="true"
                android:contentDescription="Avançar 10s"
                android:focusable="true"
                android:padding="13dp"
                android:rotation="180"
                android:src="@drawable/ic_back" />
        </LinearLayout>

        <!-- Bottom Controls Bar -->
        <LinearLayout
            android:id="@+id/playerBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_scrim_bottom"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/timeProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlayerCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/playerSeekBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="@color/primary_default"
                    android:secondaryProgressTint="#40FFFFFF"
                    android:thumbTint="@color/primary_default" />

                <TextView
                    android:id="@+id/tvPlayerTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
