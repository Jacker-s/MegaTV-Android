<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MegaTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>
        <item name="colorPrimary">@color/primary_default</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/accent_color</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:navigationBarColor">#0B0C0E</item>
        <item name="android:statusBarColor">#00000000</item>
    </style>

    <style name="Theme.MegaTV.Player" parent="Theme.MegaTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:keepScreenOn">true</item>
        <item name="android:windowBackground">#000000</item>
    </style>
</resources>
