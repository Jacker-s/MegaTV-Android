<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background">

    <LinearLayout
        android:id="@+id/registerMainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="28dp"
        android:paddingVertical="18dp">

    <!-- Left Column: Registration Form -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgRegisterLogo"
                android:layout_width="110dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/banner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Crie sua Conta"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etRegisterName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:hint="Nome Completo"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:nextFocusRight="@id/tvVirtualKeyboardRegister"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etRegisterUsername"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:hint="Usuário"
            android:importantForAutofill="no"
            android:inputType="text"
            android:nextFocusRight="@id/tvVirtualKeyboardRegister"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:hint="E-mail"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:nextFocusRight="@id/tvVirtualKeyboardRegister"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:hint="Senha"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:nextFocusRight="@id/tvVirtualKeyboardRegister"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <com.mega.tv.ui.custom.TvFocusButton
            android:id="@+id/btnRegisterSubmit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="Cadastrar e Continuar"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/registerProgressBar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/primary_default"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvRegisterError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:textColor="@color/status_expired"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tv_focus_link"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Já tem uma conta? Entrar"
            android:textColor="@color/accent_color"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Column: Virtual Keyboard -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1.25"
        android:background="@drawable/bg_glass_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="18dp">

        <TextView
            android:id="@+id/tvKeyboardRegisterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Digite pelo controle remoto (Campo: Nome)"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.mega.tv.ui.custom.TvVirtualKeyboard
            android:id="@+id/tvVirtualKeyboardRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
